import cv2
import cv2.aruco as aruco
import numpy as np

def aplicar_video_ar(frame, frame_video, esquinas_destino):
    """Proyecta un frame de video sobre las esquinas del marcador"""
    h_v, w_v = frame_video.shape[:2]
    
    # Puntos origen (el video completo)
    pts_origen = np.array([[0, 0], [w_v-1, 0], [w_v-1, h_v-1], [0, h_v-1]], dtype=np.float32)
    
    # Calcular la matriz de Homografía
    H, _ = cv2.findHomography(pts_origen, esquinas_destino.astype(np.float32))
    
    # Transformar el frame del video para que encaje en el marcador
    video_warped = cv2.warpPerspective(frame_video, H, (frame.shape[1], frame.shape[0]))
    
    # Crear una máscara negra en el área del marcador para "limpiar" el espacio
    mascara = np.zeros((frame.shape[0], frame.shape[1]), dtype=np.uint8)
    cv2.fillConvexPoly(mascara, esquinas_destino.astype(int), 255)
    
    # Invertir máscara para quitar el marcador del frame original
    mascara_inv = cv2.bitwise_not(mascara)
    
    # Combinar: Fondo del mundo real (sin el marcador) + Video transformado
    frame_bg = cv2.bitwise_and(frame, frame, mask=mascara_inv)
    frame_final = cv2.add(frame_bg, video_warped)
    
    return frame_final

def main():
    # 1. Captura de Cámara y Carga de Video
    cap = cv2.VideoCapture(0)
    video_ar = cv2.VideoCapture("mi_video_comercial.mp4") # <--- Pon aquí tu video
    
    # Detector ArUco
    diccionario = aruco.getPredefinedDictionary(aruco.DICT_6X6_250)
    parametros = aruco.DetectorParameters()
    detector = aruco.ArucoDetector(diccionario, parametros)
    
    print("📺 Proyectando video... Presiona 'q' para salir.")

    while True:
        ret, frame = cap.read()
        ret_v, f_video = video_ar.read()
        
        if not ret: break
        
        # Si el video AR termina, reiniciarlo (Loop)
        if not ret_v:
            video_ar.set(cv2.CAP_PROP_POS_FRAMES, 0)
            ret_v, f_video = video_ar.read()
        
        # Detectar marcadores
        esquinas, ids, _ = detector.detectMarkers(frame)
        
        if ids is not None:
            # Proyectar el video sobre el primer marcador detectado (ID 0 por ejemplo)
            frame = aplicar_video_ar(frame, f_video, esquinas[0][0])
            
            # Opcional: Dibujar borde fino para que parezca una pantalla real
            cv2.polylines(frame, [esquinas[0][0].astype(int)], True, (255, 255, 255), 2)
        
        cv2.imshow('AR Video Player - UTNG', frame)
        
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break
            
    cap.release()
    video_ar.release()
    cv2.destroyAllWindows()

if __name__ == "__main__":
    main()