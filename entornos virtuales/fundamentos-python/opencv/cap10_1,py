import cv2
import cv2.aruco as aruco
import numpy as np
import os # Añadido para verificar archivos

def aplicar_video_ar(frame, frame_video, esquinas_destino):
    # Si por alguna razón el frame del video llega vacío, regresamos el frame original
    if frame_video is None:
        return frame
        
    h_v, w_v = frame_video.shape[:2]
    pts_origen = np.array([[0, 0], [w_v-1, 0], [w_v-1, h_v-1], [0, h_v-1]], dtype=np.float32)
    
    H, _ = cv2.findHomography(pts_origen, esquinas_destino.astype(np.float32))
    video_warped = cv2.warpPerspective(frame_video, H, (frame.shape[1], frame.shape[0]))
    
    mascara = np.zeros((frame.shape[0], frame.shape[1]), dtype=np.uint8)
    cv2.fillConvexPoly(mascara, esquinas_destino.astype(int), 255)
    
    mascara_inv = cv2.bitwise_not(mascara)
    frame_bg = cv2.bitwise_and(frame, frame, mask=mascara_inv)
    frame_final = cv2.add(frame_bg, video_warped)
    
    return frame_final

def main():
    # --- CONFIGURACIÓN ---
    nombre_video = "mi_video_comercial.mp4" # <--- ¡ASEGÚRATE QUE ESTÉ BIEN ESCRITO!
    
    # Verificar si el archivo existe antes de empezar
    if not os.path.exists(nombre_video):
        print(f"❌ ERROR: No se encuentra el archivo '{nombre_video}' en la carpeta.")
        print(f"Ruta actual: {os.getcwd()}")
        return

    cap = cv2.VideoCapture(0)
    video_ar = cv2.VideoCapture(nombre_video)
    
    # Detector ArUco
    diccionario = aruco.getPredefinedDictionary(aruco.DICT_6X6_250)
    parametros = aruco.DetectorParameters()
    detector = aruco.ArucoDetector(diccionario, parametros)
    
    print("📺 Buscando marcador ArUco... Presiona 'q' para salir.")

    while True:
        ret, frame = cap.read()
        ret_v, f_video = video_ar.read()
        
        if not ret: break
        
        # Loop del video
        if not ret_v:
            video_ar.set(cv2.CAP_PROP_POS_FRAMES, 0)
            ret_v, f_video = video_ar.read()
        
        # Detectar marcadores
        esquinas, ids, _ = detector.detectMarkers(frame)
        
        if ids is not None:
            # Solo intentamos aplicar AR si f_video NO es None
            if f_video is not None:
                frame = aplicar_video_ar(frame, f_video, esquinas[0][0])
                cv2.polylines(frame, [esquinas[0][0].astype(int)], True, (255, 255, 255), 2)
            else:
                cv2.putText(frame, "ERROR: Video no cargado", (50,50), 
                            cv2.FONT_HERSHEY_SIMPLEX, 1, (0,0,255), 2)
        
        cv2.imshow('AR Video Player - UTNG', frame)
        
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break
            
    cap.release()
    video_ar.release()
    cv2.destroyAllWindows()

if __name__ == "__main__":
    main()